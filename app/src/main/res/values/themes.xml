<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Базовая тема. Все 12 тем — тёмные (стандарт TV-интерфейсов),
      различаются палитрой: фон / панели / карточки / акцент / обводка фокуса.
    -->
    <style name="Theme.AstraPlay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/astral_bg</item>
        <item name="android:colorBackground">@color/astral_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAllowReturnTransitionOverlap">false</item>
        <item name="colorPrimary">@color/astral_accent</item>
        <item name="colorPrimaryDark">@color/astral_bg</item>
        <item name="colorAccent">@color/astral_accent</item>
        <item name="panelBg">@color/astral_panel</item>
        <item name="cardBg">@color/astral_card</item>
        <item name="focusStroke">@color/astral_stroke</item>
    </style>

