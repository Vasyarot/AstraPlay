<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Гибрид: и TV (leanback), и сенсорные устройства -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- IPTV-потоки часто идут по http -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_astraplay"
        android:roundIcon="@mipmap/ic_astraplay_round"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.AstraPlay.Astral"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".player.LivePlayerActivity" android:exported="false"
            android:showWhenLocked="true" android:turnScreenOn="true"
            android:screenOrientation="landscape" android:theme="@style/Theme.AstraPlay.Player" />
        <activity android:name=".player.EmbedPlayerActivity" android:exported="false"
            android:screenOrientation="landscape" android:theme="@style/Theme.AstraPlay.Player" />
        <activity android:name=".player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="false"
            android:theme="@style/Theme.AstraPlay.Player" />

        <activity
            android:name=".ui.iptv.IptvActivity"
            android:exported="false" />
        <activity
            android:name=".ui.iptv.EpgGridActivity"
            android:exported="false" />
        <activity
            android:name=".ui.smb.SmbBrowserActivity"
            android:exported="false" />
        <activity android:name=".ui.torrent.TorrentPlayerActivity" android:exported="false" />
        <activity
            android:name=".player.YouTubeActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AstraPlay.Player" />
        <activity android:name=".ui.movies.SourcesActivity" android:exported="false" />
        <activity android:name=".ui.movies.SourceWebActivity" android:exported="false" />
        <activity android:name=".ui.movies.SourceDetailsActivity" android:exported="false" />
        <activity
            android:name=".ui.movies.CatalogActivity"
            android:exported="false" />
        <activity
            android:name=".ui.movies.DetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.torrent.TorrentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.local.LocalActivity"
            android:exported="false" />
        <activity
            android:name=".ui.data.UserDataActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <!-- Глобальный поиск Android TV: иконка микрофона на системном лаунчере -->
        <provider
            android:name=".tv.SearchProvider"
            android:authorities="com.astraplay.tv.search"
            android:exported="true"
            android:permission="android.permission.GLOBAL_SEARCH" />

        <receiver
            android:name=".tv.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Таймер включения: будильник AlarmManager запускает телеканал -->
        <receiver
            android:name=".tv.WakeReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
